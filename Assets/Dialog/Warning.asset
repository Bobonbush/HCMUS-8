  m_Script: {fileID: 11500000, guid: 83d0b0481880beb49bd60646c38a5d1b, type: 3}
  m_Name: Warning
  m_EditorClassIdentifier: Assembly-CSharp::DialogNode
  speakerName: "\u26A0\uFE0F HEALTH & SAFETY WARNING"
  text: 'This game contains flashing lights, rapidly changing images, intense visual
    effects, and other lighting effects that may cause discomfort or trigger seizures
    in some individuals.


    If you have a history of epilepsy, seizures, heart
    conditions, or are sensitive to flashing or strobing lights, please consult a
    doctor before playing.


    Stop playing immediately and seek medical attention
    if you experience dizziness, nausea, headaches, blurred vision, muscle twitching,
    loss of awareness, or any other unusual symptoms.


    Player discretion is
    advised.'
